{
  "model_path": "models/Qwen2.5-7B-Instruct",
  "quant": "nf4",
  "device": "cuda",
  "dtype": "bfloat16",
  "attn_implementation": "eager",
  "chat": true,
  "seed": 0,
  "grad_checkpoint": true,
  "probe_variants": true,
  "append_eos": true,
  "auto_wrong": false,

  "topk_per_layer": 32,
  "use_gradxact": true,
  "max_candidates": 1024,
  "balance_layers": true,

  "group_size": 8,
  "calibrate_epsilon": false,
  "epsilon_ablate": 0.1,
  "epsilon_row": 0.05,
  "min_named": 0,
  "max_named": 10000,

  "lr": 0.0001,
  "weight_decay": 0.0,
  "steps": 200,
  "batch_size": 8,
  "eval_every": 20,
  "max_seq_len": 512,
  "warmup_steps": 5,
  "grad_clip": 1.0,
  "kl_lambda": 0.3,
  "kl_every": 1,
  "background_path": "configs/background.txt",
  "background_size": 32,
  "background_tokens": 64,
  "guard_ratio": 0.15,
  "max_new_tokens": 16,

  "verify_fix_ratio": 0.95,
  "verify_bg_kl_max": 0.01,
  "verify_bg_kl_max_single": 0.05,

  "ledger_dir": "artifacts/ledger-7b",
  "out_dir": "artifacts/runs-7b",
  "copy_ledger": true,
  "write_back": true,
  "verify_post_requant": true
}
