{
  "model_path": "models/Qwen2.5-0.5B-Instruct",
  "quant": "nf4",
  "device": "cuda",
  "dtype": "bfloat16",
  "attn_implementation": "eager",
  "chat": true,
  "seed": 0,
  "grad_checkpoint": false,
  "probe_variants": true,
  "append_eos": true,
  "auto_wrong": true,

  "topk_per_layer": 16,
  "use_gradxact": true,
  "max_candidates": 512,
  "balance_layers": true,

  "group_size": 8,
  "calibrate_epsilon": true,
  "null_groups": 4,
  "min_named": 16,
  "max_named": 256,

  "lr": 0.001,
  "weight_decay": 0.0,
  "steps": 120,
  "batch_size": 4,
  "eval_every": 20,
  "max_seq_len": 256,
  "warmup_steps": 5,
  "grad_clip": 1.0,
  "kl_lambda": 0.3,
  "kl_every": 4,
  "background_path": "configs/background.txt",
  "background_size": 16,
  "background_tokens": 48,
  "guard_ratio": 0.5,
  "max_new_tokens": 12,

  "verify_fix_ratio": 0.8,
  "verify_bg_kl_max": 0.2,
  "verify_bg_kl_max_single": 0.5,

  "ledger_dir": "artifacts/ledger",
  "out_dir": "artifacts/runs",
  "copy_ledger": true,
  "write_back": true,
  "verify_post_requant": true
}
